+fn config_with_tun(config: &str, tun_fd: c_int) -> Result<String, String> {
+    if tun_fd < 0 {
+        return Err("invalid TUN file descriptor".to_string());
     }
+
+    let mut root: Value = serde_yaml::from_str(config)
+        .map_err(|e| format!("invalid Clash YAML: {e}"))?;
+    let mapping = root
+        .as_mapping_mut()
+        .ok_or_else(|| "Clash YAML root must be a mapping".to_string())?;
+
+    let mut tun = Mapping::new();
+    tun.insert(Value::String("enable".to_string()), Value::Bool(true));
+    tun.insert(
+        Value::String("device-id".to_string()),
+        Value::String(format!("fd://{tun_fd}")),
+    );
+    tun.insert(
+        Value::String("gateway".to_string()),
+        Value::String("198.18.0.1/30".to_string()),
+    );
+    tun.insert(
+        Value::String("gateway-v6".to_string()),
+        Value::String("fd00:198:18::1/126".to_string()),
+    );
+    tun.insert(Value::String("route-all".to_string()), Value::Bool(false));
+    tun.insert(Value::String("dns-hijack".to_string()), Value::Bool(true));
+    tun.insert(
+        Value::String("mtu".to_string()),
+        Value::Number(1500.into()),
+    );
+    mapping.insert(Value::String("tun".to_string()), Value::Mapping(tun));
+
+    serde_yaml::to_string(&root).map_err(|e| format!("failed to prepare Clash YAML: {e}"))
 }

+/// Starts one Clash instance using an already-created HarmonyOS VPN TUN FD.
+/// Returns an allocated empty string on success, otherwise an error string.
+///
+/// # Safety
+/// All string pointers must be valid, non-null, NUL-terminated UTF-8 strings.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn clash_start_with_tun_fd(
+    config: *const c_char,
+    log: *const c_char,
+    cwd: *const c_char,
+    tun_fd: c_int,
+) -> *mut c_char {
+    if config.is_null() || log.is_null() || cwd.is_null() {
+        return result_string("null FFI argument");
+    }
+
+    let mut instance = INSTANCE.lock().unwrap();
+    if instance
+        .as_ref()
+        .is_some_and(|running| !running.handle.is_finished())
+    {
+        return result_string("Clash instance is already running");
+    }
+    if let Some(finished) = instance.take() {
+        let _ = finished.handle.join();
+    }
+
+    let config_str = unsafe { CStr::from_ptr(config) }
+        .to_str()
+        .unwrap_or_default();
+    let log_str = unsafe { CStr::from_ptr(log) }
+        .to_str()
+        .unwrap_or_default()
+        .to_string();
+    let cwd_str = unsafe { CStr::from_ptr(cwd) }
+        .to_str()
+        .unwrap_or_default()
+        .to_string();
+    let prepared = match config_with_tun(config_str, tun_fd) {
+        Ok(prepared) => prepared,
+        Err(error) => return result_string(error),
+    };
+
+    let options = Options {
+        config: Config::Str(prepared),
+        cwd: Some(cwd_str),
+        rt: Some(TokioRuntime::MultiThread),
+        log_file: Some(log_str),
+        config_path: None,
+    };
+
+    match start_scaffold_instance(options) {
+        Ok((handle, token)) => {
+            *instance = Some(RunningInstance { handle, token });
+            result_string("")
+        }
+        Err(error) => result_string(format!("{error}")),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn clash_is_running() -> c_int {
+    let mut instance = INSTANCE.lock().unwrap();
+    if instance
+        .as_ref()
+        .is_some_and(|running| !running.handle.is_finished())
+    {
+        return 1;
+    }
+    if let Some(finished) = instance.take() {
+        let _ = finished.handle.join();
+    }
+    0
+}
