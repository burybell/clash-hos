{
  "modelVersion": "5.1.0",
  "dependencies": {},
  "execution": {
    "daemon": false,
    "incremental": true,
    "parallel": true,
    "typeCheck": true
  },
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {
    "maxOldSpaceSize": 4096,
    "exposeGC": true
  }
}
